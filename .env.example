# Every setting SeatRush reads, with its default value.
# You don't need a .env file: docker compose and the API both use these
# defaults. Copy this file to .env only if you want to change something.

# --- Database: how the API reaches PostgreSQL when it runs on your machine ---
DB_HOST=localhost
# Port on your machine. docker-compose maps 55432 (host) -> 5432 (container).
DB_PORT=55432
DB_USER=seatrush
DB_PASSWORD=seatrush
DB_NAME=seatrush

# --- Business rules from the brief ---
# How long a hold lasts, in seconds (rule 3). The tests use a short value.
HOLD_TTL_SECONDS=300
# The most seats one fan can have per event, held + bought together (rule 4).
MAX_SEATS_PER_USER=4
# Extra credit: refuse holds that leave one seat stuck alone. Off by default,
# so best available answers B2–B3 for the brief's example (on: C4–C5).
NO_LONE_SEATS=false

# --- API ---
PORT=3000
# Create one demo event (already on sale) when the database has no events.
SEED_DEMO_EVENT=true
# The web app's origin, allowed to call the API directly from a browser.
CORS_ORIGIN=http://localhost:5173
